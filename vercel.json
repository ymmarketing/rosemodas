{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/vitrine",
  "rewrites": [
    { "source": "/painel", "destination": "/index.html" },
    { "source": "/painel/:path*", "destination": "/index.html" },
    { "source": "/cliente", "destination": "/index.html" },
    { "source": "/cliente/:path*", "destination": "/index.html" }
  ]
}
